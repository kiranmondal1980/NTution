# ==============================================================================
# NSE MOMENTUM 5™ — Secrets Template File
# ==============================================================================
# SECURITY INSTRUCTION:
# 1. NEVER commit your real secrets.toml or API keys to any GitHub repository.
# 2. For local development, copy this file to: .streamlit/secrets.toml
# 3. For Streamlit Cloud deployment, paste these sections into:
#    App Settings -> Secrets on share.streamlit.io
# ==============================================================================

[database]
# Default local SQLite URI or cloud PostgreSQL URI
db_uri = "sqlite:///data_store/nse_momentum_5.db"

[data_provider]
# Active provider ("yfinance", "truedata", "zerodha_kite")
provider_name = "yfinance"
api_key = "YOUR_API_KEY_HERE"
api_secret = "YOUR_API_SECRET_HERE"

[alerts]
# Optional alert integration webhooks (Telegram / Email / Webhook)
telegram_bot_token = ""
telegram_chat_id = ""
webhook_url = ""
